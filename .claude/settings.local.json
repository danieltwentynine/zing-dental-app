{
  "permissions": {
    "allow": [
      "Bash(npx expo *)",
      "Read(//Users/log05/**)",
      "Bash(env)",
      "Bash(npm install *)",
      "Bash(rm -rf Pods Podfile.lock build)",
      "Bash(pod install *)",
      "Read(//private/tmp/**)",
      "Bash(xcrun simctl *)",
      "Bash(curl -s \"http://localhost:8081/index.bundle?platform=ios&dev=true\" -o /tmp/bundle-check.js)",
      "Read(//tmp/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/log05/.bridgespace/bin/bs-claude-hook.cjs' session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/log05/.bridgespace/bin/bs-claude-hook.cjs' user-prompt-submit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/log05/.bridgespace/bin/bs-claude-hook.cjs' stop idle \"Finished working\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/log05/.bridgespace/bin/bs-claude-hook.cjs' notification needs-input \"Needs input\""
          }
        ]
      }
    ]
  }
}
