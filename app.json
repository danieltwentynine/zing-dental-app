{
  "expo": {
    "name": "Zing",
    "slug": "zing",
    "version": "1.0.0",
    "scheme": "zing",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zingdentalai.zing",
      "infoPlist": {
        "NSCameraUsageDescription": "Zing uses the front camera to see your child's mouth while they brush. Video stays on this phone and is never saved or sent anywhere."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#2D5BFF",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.925227389891-q1qbhnos6l78qchb1ajfn99js33fkml7"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2D5BFF"
        }
      ],
      "./plugins/withSceneLifecycle"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9d41921-b061-4b1d-9bc8-813ad94f21ed"
      }
    },
    "owner": "zing-dental-ai"
  }
}
