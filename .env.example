# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings → General → Your apps) and Google AI Studio (Gemini key).
# .env.local is gitignored — never commit real keys.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GEMINI_API_KEY=

# Google Sign-In. Both come from Firebase console → Project settings → Your apps,
# or Google Cloud console → APIs & Services → Credentials.
# WEB is the "Web client (auto created by Google Service)" OAuth client — Firebase
# verifies the ID token against it, so it is required even on native.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

